library IEEE;
use IEEE.STD_LOGIC_1164.all;
use IEEE.NUMERIC_STD.all;

-- DMem interface (LUT) - skrivning & läsning
entity DMem is
  port(
    dAddr : in unsigned(15 downto 0);
    we_d : in std_logic; -- write enable
    clk : in std_logic;
    dData_i : in unsigned(15 downto 0);
    dData_o : out unsigned(15 downto 0));
end DMem;

architecture Behavioral of DMem is

-- Data Memory
  type d_mem_t is array (0 to 1023) of unsigned(15 downto 0);
  signal d_mem : d_mem_t := (0 => "0000000000000001", others => (others => '0'));


begin -- dMem
  -- Synkron skrivning
  process(clk)
  begin  
    if rising_edge(clk) then
      if we_d = '1' then
         d_mem(to_integer(dAddr)) <= dData_i;
      end if;
    end if;
  end process;

-- kombinatorisk läsning
  dData_o <= d_mem(to_integer(dAddr));
  
end Behavioral;
